# Doggy Kizz website: Firebase settings. Use ONLY Doggy Kizz's own Firebase project here.
# Copy this file to ".env" and fill it in (Firebase console > Project settings > Your apps > Web app).
# These are public web-app settings, not secrets. On GitHub Pages, put the same names in
# the repository's Settings > Secrets and variables > Actions > Variables (the "Variables" tab) instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
# Leave empty until the "Trigger Email from Firestore" extension is installed, then set to: extension
VITE_NEWSLETTER_SENDER=
